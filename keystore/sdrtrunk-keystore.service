[Unit]
Description=Radio Keystore - SDRTrunk encryption key manager
After=network.target

[Service]
Type=simple
User=n6lka
Group=n6lka
WorkingDirectory=/opt/sdrtrunk-src/keystore
ExecStart=/opt/sdrtrunk-src/keystore/venv/bin/python3 server.py
Restart=on-failure
RestartSec=5

# Sandboxing - the DB dir is the only thing this needs to write to.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sdrtrunk-keystore

[Install]
WantedBy=multi-user.target
